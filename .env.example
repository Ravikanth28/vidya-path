# ── Mentor + VidyaPath core ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://user:password@host:4000/database

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ── LLM Router (multi-provider with auto-fallback) ───────────────────────
# Cerebras (primary). Up to 5 keys are rotated per request.
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_MODEL=llama3.3-70b

# Groq (secondary).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (tertiary).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Sarvam AI (STT + TTS for Indian languages) ───────────────────────────
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=meera

# ── ML sidecar (Python FastAPI) ──────────────────────────────────────────
# Run: python -m uvicorn ml_sidecar.main:app --host 0.0.0.0 --port 8000
ML_SIDECAR_URL=http://127.0.0.1:8000
ML_SIDECAR_TIMEOUT_MS=6000

# ── Communication test transcription concurrency (existing Mentor app) ───
COMM_TEST_SYNC_STT_CONCURRENCY=4
COMM_TEST_BG_STT_CONCURRENCY=2

# ── Frontend ─────────────────────────────────────────────────────────────
# (read by client/vite.config.js and client/src/* — set to your API origin)
VITE_API_URL=http://localhost:3000
